    MainFrame.Name = "MainContainer"
    MainFrame.Size = UDim2.new(0, 480, 0, 300) -- Diperlebar untuk space Sidebar (Kiri)
    MainFrame.Position = UDim2.new(0.5, -240, 0.5, -150)
