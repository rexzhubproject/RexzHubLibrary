    SearchInput.TextColor3 = Color3.fromRGB(220, 220, 230)
    SearchInput.TextSize = 12
    SearchInput.Font = Enum.Font.GothamMedium
    SearchInput.TextXAlignment = Enum.TextXAlignment.Left
    SearchInput.Parent = SearchFrame

    -- =======================================================
    -- TABS CONTAINER HOLDER (KANAN BAWAH)
    -- =======================================================
    local ContentHolder = Instance.new("Frame")
    ContentHolder.Name = "ContentHolder"
    ContentHolder.Size = UDim2.new(1, -165, 1, -96)
    ContentHolder.Position = UDim2.new(0, 150, 0, 88)
    ContentHolder.BackgroundTransparency = 1
    ContentHolder.Parent = MainFrame
    self.ContentHolder = ContentHolder

    -- REALTIME GLOBAL SEARCH ENGINE
    SearchInput:GetPropertyChangedSignal("Text"):Connect(function()
        local query = string.lower(SearchInput.Text)
        if self.CurrentTab then
            for _, item in ipairs(self.CurrentTab.Elements) do
                if query == "" then
                    item.Instance.Visible = true
                else
                    if string.find(string.lower(item.Name), query) then
                        item.Instance.Visible = true
                    else
                        item.Instance.Visible = false
                    end
                end
            end
        end
    end)

    return self
end

-- =======================================================
-- METHOD: CREATE TAB (Membuat Tab Sidebar Baru) 🤓
-- =======================================================
function RexzLibrary:CreateTab(tabName, iconId)
    local tab = setmetatable({}, TabClass)
    tab.Elements = {}
    
    -- Pembuat Tombol Navigasi di Sidebar
    local TabButton = Instance.new("TextButton")
    TabButton.Name = tabName .. "_TabBtn"
    TabButton.Size = UDim2.new(1, -5, 0, 34)
    TabButton.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
    TabButton.Text = ""
    TabButton.BorderSizePixel = 0
    TabButton.Parent = self.MainFrame.Sidebar

    local TabBtnCorner = Instance.new("UICorner")
    TabBtnCorner.CornerRadius = UDim.new(0, 6)
    TabBtnCorner.Parent = TabButton

    if iconId then
        local TabIcon = Instance.new("ImageLabel")
        TabIcon.Name = "TabIcon"
        TabIcon.Size = UDim2.new(0, 16, 0, 16)
        TabIcon.Position = UDim2.new(0, 10, 0.5, -8)
        TabIcon.BackgroundTransparency = 1
        TabIcon.Image = "rbxassetid://" .. tostring(iconId)
        TabIcon.ImageColor3 = Color3.fromRGB(150, 150, 160)
        TabIcon.Parent = TabButton
        tab.Icon = TabIcon
    end

    local TabLabel = Instance.new("TextLabel")
    TabLabel.Name = "TabLabel"
    TabLabel.Size = UDim2.new(1, iconId and -36 or -16, 1, 0)
    TabLabel.Position = UDim2.new(0, iconId and 32 or 12, 0, 0)
    TabLabel.BackgroundTransparency = 1
    TabLabel.Text = tabName
    TabLabel.TextColor3 = Color3.fromRGB(160, 160, 170)
    TabLabel.TextSize = 12
    TabLabel.Font = Enum.Font.GothamMedium
    TabLabel.TextXAlignment = Enum.TextXAlignment.Left
    TabLabel.Parent = TabButton
    tab.Label = TabLabel

    -- Pembuat Container Scrolling Frame Konten Tab (Kanan)
    local ScrollBox = Instance.new("ScrollingFrame")
    ScrollBox.Name = tabName .. "_ContentScroll"
    ScrollBox.Size = UDim2.new(1, 0, 1, 0)
    ScrollBox.BackgroundTransparency = 1
    ScrollBox.BorderSizePixel = 0
    ScrollBox.ScrollBarThickness = 3
    ScrollBox.ScrollBarImageColor3 = Color3.fromRGB(50, 50, 60)
    ScrollBox.CanvasSize = UDim2.new(0, 0, 0, 0)
    ScrollBox.Visible = false
    ScrollBox.Parent = self.ContentHolder
    tab.ScrollBox = ScrollBox

    local ListLayout = Instance.new("UIListLayout")
    ListLayout.Parent = ScrollBox
    ListLayout.SortOrder = Enum.SortOrder.LayoutOrder
    ListLayout.Padding = UDim.new(0, 6)

    ListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        ScrollBox.CanvasSize = UDim2.new(0, 0, 0, ListLayout.AbsoluteContentSize.Y + 10)
    end)

    -- Fungsi Aktivasi Ganti Tab 😈
    local function ActivateTab()
        for _, t in ipairs(self.Tabs) do
            t.ScrollBox.Visible = false
            t.BackgroundColor.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
            t.Label.TextColor3 = Color3.fromRGB(160, 160, 170)
            if t.Icon then t.Icon.ImageColor3 = Color3.fromRGB(150, 150, 160) end
        end
        scrollBox.Visible = true
        TabButton.BackgroundColor3 = Color3.fromRGB(32, 30, 42)
        TabLabel.TextColor3 = Color3.fromRGB(160, 110, 255) -- Warna khas lavender ungu saat aktif
        if tab.Icon then tab.Icon.ImageColor3 = Color3.fromRGB(160, 110, 255) end
        self.CurrentTab = tab
    end

    TabButton.MouseButton1Click:Connect(ActivateTab)
    
    tab.BackgroundColor = TabButton
    table.insert(self.Tabs, tab)

    -- Auto aktifkan tab pertama yang dibuat
    if #self.Tabs == 1 then
        ActivateTab()
    end

    return tab
end

-- =======================================================
-- METHOD: ADD BUTTON (Membuat Tombol di Dalam Tab Spesifik) 😡
-- =======================================================
function TabClass:AddButton(text, iconId, callback)
    local action = callback or function() end
    
    local ButtonElement = Instance.new("TextButton")
    ButtonElement.Name = text .. "_Interaction"
    ButtonElement.Size = UDim2.new(1, -4, 0, 36)
    ButtonElement.BackgroundColor3 = Color3.fromRGB(26, 26, 33)
    ButtonElement.BorderSizePixel = 0
    ButtonElement.Text = ""
    ButtonElement.AutoButtonColor = true
    ButtonElement.Parent = self.ScrollBox

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 6)
    BtnCorner.Parent = ButtonElement

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = Color3.fromRGB(35, 35, 45)
    BtnStroke.Thickness = 1
    BtnStroke.Parent = ButtonElement

    if iconId then
        local IconSpec = Instance.new("ImageLabel")
        IconSpec.Name = "ButtonIcon"
        IconSpec.Size = UDim2.new(0, 16, 0, 16)
        IconSpec.Position = UDim2.new(0, 10, 0, 10)
        IconSpec.BackgroundTransparency = 1
        IconSpec.Image = "rbxassetid://" .. tostring(iconId)
        IconSpec.ImageColor3 = Color3.fromRGB(210, 210, 220)
        IconSpec.Parent = ButtonElement
    end

    local Label = Instance.new("TextLabel")
    Label.Name = "ButtonLabel"
    Label.Size = UDim2.new(1, iconId and -40 or -20, 1, 0)
    Label.Position = UDim2.new(0, iconId and 34 or 12, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(215, 215, 225)
    Label.TextSize = 12
    Label.Font = Enum.Font.GothamMedium
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Parent = ButtonElement

    ButtonElement.MouseButton1Click:Connect(function()
        ButtonElement.BackgroundColor3 = Color3.fromRGB(38, 38, 48)
        task.wait(0.08)
        ButtonElement.BackgroundColor3 = Color3.fromRGB(26, 26, 33)
        pcall(action)
    end)

    table.insert(self.Elements, {
        Name = text,
        Instance = ButtonElement
    })
end

return RexzLibrary
